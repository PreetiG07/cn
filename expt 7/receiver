import socket

# Create UDP socket
receiver = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

# IP address and port
receiver.bind(("0.0.0.0", 5000))

print("Receiver is waiting for file...")

# Receive file name
file_name, sender_address = receiver.recvfrom(1024)
file_name = file_name.decode()

print("Receiving file:", file_name)

# Open file for writing
with open("received_" + file_name, "wb") as file:

    while True:
        data, sender_address = receiver.recvfrom(4096)

        # End of file
        if data == b"EOF":
            break

        file.write(data)

print("File received successfully!")

receiver.close()
